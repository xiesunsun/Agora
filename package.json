{
  "name": "blackboard-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @blackboard/frontend dev",
    "dev:backend": "pnpm --filter @blackboard/backend dev",
    "build": "pnpm --filter @blackboard/frontend build",
    "build:all": "pnpm --filter ./packages/blackboard-runtime build",
    "build:backend": "pnpm --filter @blackboard/backend build",
    "e2e": "pnpm --filter @blackboard/frontend e2e",
    "harness:arch": "node harness/scripts/check.mjs --arch",
    "harness:boundary": "node harness/scripts/check.mjs --boundary",
    "harness:check": "node harness/scripts/check.mjs",
    "harness:naming": "node harness/scripts/check.mjs --naming",
    "harness:report": "node harness/scripts/check.mjs --report",
    "lint": "pnpm --filter @blackboard/frontend lint",
    "format": "pnpm --filter @blackboard/frontend format",
    "test": "pnpm --filter @blackboard/frontend test",
    "test:all": "pnpm test && pnpm test:backend && pnpm --filter @blackboard/host-adapter test",
    "test:backend": "pnpm --filter @blackboard/backend test",
    "typecheck:all": "pnpm --filter @blackboard/frontend lint && pnpm --filter @blackboard/backend build && pnpm --filter @blackboard/host-adapter typecheck",
    "adapter": "pnpm --filter @blackboard/host-adapter start",
    "adapter:dev": "pnpm --filter @blackboard/host-adapter dev",
    "runtime": "pnpm --filter ./packages/blackboard-runtime start",
    "runtime:dev": "pnpm --filter ./packages/blackboard-runtime dev",
    "smoke:agora": "node harness/scripts/smoke-agora-published-install.mjs",
    "reinstall": "bash scripts/reinstall.sh"
  }
}
